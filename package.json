{
  "name": "ifs-passcode-relay",
  "private": true,
  "version": "0.1.0",
  "description": "Telegram bot for collaboratively assembling an Ingress First Saturday event passcode in real time.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grifwl/ifs-passcode-relay.git"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply ifs-passcode-relay --local",
    "db:migrate:remote": "wrangler d1 migrations apply ifs-passcode-relay --remote",
    "bot:set-commands": "node scripts/set-commands.mjs"
  },
  "dependencies": {
    "grammy": "^1.45.1",
    "hono": "^4.13.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260820.1": true
  }
}
